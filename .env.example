# Tier Core — PostgreSQL
POSTGRES_DB=agent_retry_core
POSTGRES_USER=retrysight_core
POSTGRES_PASSWORD=changeme-core
POSTGRES_PORT=5432

# Spring profiles (manager + agent)
SPRING_PROFILES_ACTIVE=docker,tier-core
INSTALLATION_TIER=TIER_1_CORE

# Manager
MANAGER_PORT=28471
JWT_SECRET=agent-retry-platform-dev-secret-key-32chars
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080

# Secadmin bootstrap
SECADMIN_EMAIL=secadmin@local
SECADMIN_PASSWORD=changeme
SSO_SECRET_KEY=dev-sso-secret-encryption-key-32
SSO_CALLBACK_BASE_URL=http://localhost:8080
SSO_MANAGER_BASE_URL=http://localhost:28471

# Frontend
FRONTEND_PORT=8080

# Agent ingest key
AGENT_API_KEY=dev-agent-key
AGENT_MANAGER_URL=http://manager:28471

# Native / Docker agent — host IDE log directories (optional overrides)
# Windows PowerShell example: AGENT_CURSOR_DIR=C:/Users/you/.cursor
AGENT_CURSOR_DIR=
AGENT_CLAUDE_DIR=
AGENT_CODEX_DIR=

# Security (dev only)
SECURITY_ALLOW_DEFAULT_SECRETS=true

# Tier 1 — analytics disabled
CLICKHOUSE_ENABLED=false
OTEL_INGEST_ENABLED=false
CHAT_ENABLED=false

# Retention
RETENTION_TASK_EVENTS_DAYS=90

# Compose project name (isolates containers/volumes)
COMPOSE_PROJECT_NAME=retrysight-tier-core

# Release image tag (see release/manifest.yaml)
RETRYSIGHT_VERSION=1.0.0

# SSO — split IdP URLs when manager runs in Docker (see docs/SSO_CUSTOMER.md)
SSO_IDP_BROWSER_BASE_URL=http://localhost:8082
SSO_IDP_INTERNAL_BASE_URL=http://host.docker.internal:8082
